net/9fbmaqn9d9lb/5kdoDKx9wK2RSyZagChghJ/7aed4c640acd4a135bcc14f99f51dc1e/1.mp4","details":{"size":422506},"fileName":"1.mp4","contentType":"video/mp4"}}},{"fields":{"title":"ENAC Unity video 2","description":"","file":{"url":"//videos.ctfassets.net/9fbmaqn9d9lb/3KDNuIsafzDY8M4w2ph5Q2/8a9865b803d0e959874baa606505cd47/2.mp4","details":{"size":955473},"fileName":"2.mp4","contentType":"video/mp4"}}},{"fields":{"title":"ENAC Unity video 3","description":"","file":{"url":"//videos.ctfassets.net/9fbmaqn9d9lb/2e2VEDGmFClPQEjbtFExYP/79e0894ea431a5d8571051e9beb4c1e5/3.mp4","details":{"size":349391},"fileName":"3.mp4","contentType":"video/mp4"}}},{"fields":{"title":"ENAC Unity video 4","description":"","file":{"url":"//videos.ctfassets.net/9fbmaqn9d9lb/38o9nEPoaZoiyv7Dduqqob/7a2c0754fecb0f5be0f60592f5c2a79e/4.mp4","details":{"size":386805},"fileName":"4.mp4","contentType":"video/mp4"}}}],"description":"ENAC Unity is more than just a mobile app. It's a lifeline for students navigating the complexities of personal, academic, and professional spheres. Seamlessly integrating into their daily routines, it serves as a trusted companion, offering a holistic solution to their multifaceted needs.\n\\n\\n\nWhether seeking guidance on academic challenges, personal dilemmas, or career aspirations, ENAC Unity provides a safe space for students to seek advice, connect with peers, and access resources tailored to their individual journeys. \n\\n\\n\nWhat sets it apart is its innovative approach to incentivizing engagement, offering not just support but also the opportunity to earn rewards, transforming each interaction into a step forward on their path to success. With ENAC Unity, students aren't just facing their challenges alone, they're empowered to thrive, supported by a community dedicated to their growth and well-being.","location":"Toulouse, France","credits":"Anthony Rodrigo, ENAC, ENVOL J.E.","technologies":"React Native, TypeScript, Google Firebase"}},{"fields":{"title":"Babi Quiz"